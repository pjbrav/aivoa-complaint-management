# --- Groq LLM ---
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=gemma2-9b-it
GROQ_SECONDARY_MODEL=llama-3.3-70b-versatile

# --- Database ---
# Postgres example: postgresql://user:password@localhost:5432/aivoa_complaints
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivoa_complaints

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_MB=10
